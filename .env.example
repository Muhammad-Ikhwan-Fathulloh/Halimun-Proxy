# Salin ke .env lalu isi. JANGAN commit file .env.
# Buat kunci baru: halimun-proxy --keygen --format=env
HALIMUN_AES_KEY=
HALIMUN_HMAC_KEY=
HALIMUN_XOR_KEY=172
HALIMUN_BASE32_ALPHABET=ABCDEFGHIJKLMNOPQRSTUVWXYZ234567
# Minimal 16 karakter. Dipakai dashboard dan Admin API (header x-admin-key).
HALIMUN_ADMIN_KEY=

# Untuk klien (bukan dibaca server)
HALIMUN_PROXY_URL=http://localhost/proxy/1
